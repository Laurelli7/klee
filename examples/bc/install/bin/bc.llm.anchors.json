{
  "version": 1,
  "backend": "llm",
  "source": "examples/bc/src",
  "default_searcher": "nurs:covnew",
  "summary": {
    "kinds": {
      "dfs":          "Arbitrary-precision arithmetic kernels in lib/number.c. Long concrete-data digit loops with carry chains. DFS keeps us inside one path so we don't fork on shallow tests over the same loop body 10^N times.",
      "nurs:covnew":  "Parser/lexer (yyparse, yylex, scan helpers). Many cheap branches over input bytes; rewarding NewlyCovered code drives the searcher to walk the grammar.",
      "random-path":  "AST executor and code generator (execute, generate, run_code). High fork fan-out via opcode switch; random-path balances tree exploration.",
      "bfs":          "Symbol-table / storage operations (storage.c, load.c). Shallow branchy table ops; BFS expands all buckets quickly.",
      "nurs:qc":      "Symbolic-stress hot spots that allocate / multiply numbers via solver-heavy paths (rec_mul, raise, sqrt). Prefer states with cheap queries to keep solver time in check.",
      "nurs:depth":   "I/O glue and main REPL loop where deeper paths correspond to deeper input consumption."
    }
  },
  "anchors": {
    "_bc_do_add":       {"searcher": "dfs",         "reason": "ARITH-KERNEL: digit-wise add with carry chain; concrete-data inner loop"},
    "_bc_do_sub":       {"searcher": "dfs",         "reason": "ARITH-KERNEL: digit-wise subtract with borrow chain"},
    "_bc_do_compare":   {"searcher": "dfs",         "reason": "ARITH-KERNEL: digit-wise compare loop, no fork-rich branches"},
    "_bc_simp_mul":     {"searcher": "dfs",         "reason": "ARITH-KERNEL: O(n*m) schoolbook multiply, two nested concrete loops"},
    "_bc_rec_mul":      {"searcher": "nurs:qc",     "reason": "ARITH-KERNEL: recursive Karatsuba; sub-numbers are symbolic so query cost matters"},
    "_bc_shift_addsub": {"searcher": "dfs",         "reason": "ARITH-KERNEL: shift-and-addsub helper, deep linear loop"},
    "_bc_rm_leading_zeros": {"searcher": "dfs",     "reason": "ARITH-KERNEL: scan loop trimming digits, no branch fan-out"},
    "_one_mult":        {"searcher": "dfs",         "reason": "ARITH-KERNEL: single-digit multiply inner loop"},

    "bc_add":           {"searcher": "dfs",         "reason": "ARITH-KERNEL entry: dispatches sign cases then long digit loop"},
    "bc_sub":           {"searcher": "dfs",         "reason": "ARITH-KERNEL entry"},
    "bc_compare":       {"searcher": "dfs",         "reason": "ARITH-KERNEL entry"},
    "bc_multiply":      {"searcher": "nurs:qc",    "reason": "ARITH-KERNEL: dispatches to recursive multiply; mixed concrete/symbolic"},
    "bc_divide":        {"searcher": "nurs:qc",    "reason": "ARITH-KERNEL: long division with symbolic-bound iteration"},
    "bc_modulo":        {"searcher": "nurs:qc",    "reason": "ARITH-KERNEL: divmod path; solver-heavy"},
    "bc_divmod":        {"searcher": "nurs:qc",    "reason": "ARITH-KERNEL: combined divide+mod"},
    "bc_raise":         {"searcher": "nurs:qc",    "reason": "ARITH-KERNEL: integer power via repeated multiply; deep solver chain"},
    "bc_raisemod":      {"searcher": "nurs:qc",    "reason": "ARITH-KERNEL: modular exponentiation"},
    "bc_sqrt":          {"searcher": "nurs:qc",    "reason": "ARITH-KERNEL: Newton's iteration with symbolic convergence test"},

    "bc_int2num":       {"searcher": "dfs",         "reason": "ARITH helper: unroll integer into digit array"},
    "bc_num2long":      {"searcher": "dfs",         "reason": "ARITH helper: digit accumulation"},
    "bc_num2str":       {"searcher": "dfs",         "reason": "ARITH helper: digit-to-char loop"},
    "bc_str2num":       {"searcher": "nurs:covnew", "reason": "Parsing: walks input string with branch per character class"},
    "bc_out_long":      {"searcher": "dfs",         "reason": "Number printing: digit emission loop"},
    "bc_out_num":       {"searcher": "dfs",         "reason": "Number printing: arbitrary-base digit loop"},
    "bc_copy_num":      {"searcher": "dfs",         "reason": "ARITH helper: linear copy"},
    "bc_init_num":      {"searcher": "bfs",         "reason": "Allocator helper: short branchy init"},
    "bc_init_numbers":  {"searcher": "bfs",         "reason": "Init: a few constant-table writes"},
    "bc_new_num":       {"searcher": "bfs",         "reason": "Allocator: branchy malloc/init"},
    "bc_free_num":      {"searcher": "bfs",         "reason": "Deallocator"},
    "bc_is_zero":       {"searcher": "dfs",         "reason": "Linear scan over digit array"},
    "bc_is_neg":        {"searcher": "bfs",         "reason": "Single test"},
    "bc_is_near_zero":  {"searcher": "dfs",         "reason": "Linear scan"},
    "new_sub_num":      {"searcher": "bfs",         "reason": "Allocator helper"},

    "yyparse":          {"searcher": "nurs:covnew", "reason": "PARSER: bison main loop; thousands of cheap branches over token stream"},
    "yylex":            {"searcher": "nurs:covnew", "reason": "PARSER: flex DFA driver; coverage-new rewards reaching new states"},
    "yy_get_next_buffer": {"searcher": "nurs:covnew", "reason": "PARSER: input-buffer refill state machine"},
    "yy_get_previous_state": {"searcher": "nurs:covnew", "reason": "PARSER: backtracking helper"},
    "yy_try_NUL_trans": {"searcher": "nurs:covnew", "reason": "PARSER: lex DFA NUL transition"},
    "yyerror":          {"searcher": "bfs",         "reason": "Parser error reporter; small branchy code"},
    "yywrap":           {"searcher": "bfs",         "reason": "Trivial input-stream wrap"},
    "yydestruct":       {"searcher": "bfs",         "reason": "Bison cleanup for one symbol; switch over kinds"},
    "yyrestart":        {"searcher": "bfs",         "reason": "Reset lexer buffer state"},

    "yy_create_buffer": {"searcher": "bfs",         "reason": "Lexer buffer alloc"},
    "yy_delete_buffer": {"searcher": "bfs",         "reason": "Lexer buffer free"},
    "yy_init_buffer":   {"searcher": "bfs",         "reason": "Lexer buffer init"},
    "yy_flush_buffer":  {"searcher": "bfs",         "reason": "Lexer buffer reset"},
    "yy_load_buffer_state": {"searcher": "bfs",     "reason": "Lexer buffer restore"},
    "yy_switch_to_buffer": {"searcher": "bfs",      "reason": "Lexer buffer switch"},
    "yy_scan_buffer":   {"searcher": "bfs",         "reason": "Lex string-input scan setup"},
    "yy_scan_bytes":    {"searcher": "bfs",         "reason": "Lex string-input scan setup"},
    "yy_scan_string":   {"searcher": "bfs",         "reason": "Lex string-input scan setup"},
    "yyensure_buffer_stack": {"searcher": "bfs",    "reason": "Buffer stack growth"},
    "yypush_buffer_state": {"searcher": "bfs",      "reason": "Buffer stack push"},
    "yypop_buffer_state":  {"searcher": "bfs",      "reason": "Buffer stack pop"},
    "yy_init_globals":  {"searcher": "bfs",         "reason": "Lex globals init"},
    "yylex_destroy":    {"searcher": "bfs",         "reason": "Lex teardown"},
    "yyalloc":          {"searcher": "bfs",         "reason": "Lex allocator wrapper"},
    "yyrealloc":        {"searcher": "bfs",         "reason": "Lex allocator wrapper"},
    "yyfree":           {"searcher": "bfs",         "reason": "Lex allocator wrapper"},
    "yy_fatal_error":   {"searcher": "bfs",         "reason": "Lex error path; usually exits"},

    "execute":          {"searcher": "random-path", "reason": "AST/EXEC: opcode dispatch loop (giant switch on bytecode); needs balanced tree exploration"},
    "generate":         {"searcher": "random-path", "reason": "AST/EXEC: code generator emits opcodes; many code paths per AST node"},
    "run_code":         {"searcher": "random-path", "reason": "AST/EXEC: top-level interpreter loop"},
    "load_code":        {"searcher": "nurs:covnew", "reason": "Loads compiled function body; branchy parser of opcode bytes"},
    "load_var":         {"searcher": "bfs",         "reason": "Variable lookup helper"},
    "load_array":       {"searcher": "bfs",         "reason": "Array lookup helper"},
    "store_var":        {"searcher": "bfs",         "reason": "Variable assignment helper"},
    "store_array":      {"searcher": "bfs",         "reason": "Array element store"},
    "get_var":          {"searcher": "bfs",         "reason": "Symbol-table lookup"},
    "get_array_num":    {"searcher": "bfs",         "reason": "Array indexing helper"},
    "incr_var":         {"searcher": "bfs",         "reason": "++ operator on variable"},
    "decr_var":         {"searcher": "bfs",         "reason": "-- operator on variable"},
    "incr_array":       {"searcher": "bfs",         "reason": "++ on array element"},
    "decr_array":       {"searcher": "bfs",         "reason": "-- on array element"},
    "assign":           {"searcher": "bfs",         "reason": "Generic assignment dispatch"},
    "auto_var":         {"searcher": "bfs",         "reason": "Auto-variable scope helper"},
    "pop":              {"searcher": "bfs",         "reason": "Stack pop"},
    "fpush":            {"searcher": "bfs",         "reason": "Function-call stack push"},
    "fpop":             {"searcher": "bfs",         "reason": "Function-call stack pop"},
    "push_num":         {"searcher": "bfs",         "reason": "Push number on eval stack"},
    "push_copy":        {"searcher": "bfs",         "reason": "Push duplicate"},
    "push_constant":    {"searcher": "nurs:covnew", "reason": "Parses a literal string into number; branchy"},
    "push_b10_const":   {"searcher": "nurs:covnew", "reason": "Parses base-10 constant from source text"},
    "pop_vars":         {"searcher": "bfs",         "reason": "Restore caller variable bindings"},
    "process_params":   {"searcher": "bfs",         "reason": "Set up callee parameter slots"},
    "check_params":     {"searcher": "bfs",         "reason": "Validate parameter count/types"},
    "check_stack":      {"searcher": "bfs",         "reason": "Underflow check"},
    "stop_execution":   {"searcher": "bfs",         "reason": "Signal handler; trivial"},
    "use_quit":         {"searcher": "bfs",         "reason": "Exit helper"},
    "limits":           {"searcher": "bfs",         "reason": "Print limits builtin"},

    "clear_func":       {"searcher": "bfs",         "reason": "STORAGE: free a function definition; branchy"},
    "more_functions":   {"searcher": "bfs",         "reason": "STORAGE: grow function table"},
    "more_variables":   {"searcher": "bfs",         "reason": "STORAGE: grow variable table"},
    "more_arrays":      {"searcher": "bfs",         "reason": "STORAGE: grow array table"},
    "init_storage":     {"searcher": "bfs",         "reason": "STORAGE init"},
    "init_load":        {"searcher": "bfs",         "reason": "Loader init"},
    "init_tree":        {"searcher": "bfs",         "reason": "AST tree init"},
    "init_gen":         {"searcher": "bfs",         "reason": "Codegen init"},
    "free_a_tree":      {"searcher": "bfs",         "reason": "STORAGE: walk and free AST nodes"},
    "free_args":        {"searcher": "bfs",         "reason": "Free argument list"},
    "copy_tree":        {"searcher": "bfs",         "reason": "Recursive AST copy"},
    "copy_array":       {"searcher": "dfs",         "reason": "Linear array copy loop"},
    "lookup":           {"searcher": "nurs:covnew", "reason": "STORAGE: id->slot lookup with hash-bucket scan"},
    "find_id":          {"searcher": "nurs:covnew", "reason": "STORAGE: identifier table search"},
    "insert_id_rec":    {"searcher": "nurs:covnew", "reason": "STORAGE: balanced-tree insert"},

    "main":             {"searcher": "nurs:depth",  "reason": "REPL entry; deeper paths correspond to consuming more input"},
    "input":            {"searcher": "nurs:depth",  "reason": "Reads input chunks; depth tracks input progress"},
    "input_char":       {"searcher": "nurs:covnew", "reason": "Per-char branchy input handling"},
    "out_char":         {"searcher": "bfs",         "reason": "Buffered putc; trivial"},
    "out_schar":        {"searcher": "bfs",         "reason": "Output a signed char with sign handling"},
    "prog_char":        {"searcher": "bfs",         "reason": "Output a char to compiled program stream"},
    "addbyte":          {"searcher": "bfs",         "reason": "Append byte to compile buffer"},
    "byte":             {"searcher": "bfs",         "reason": "Compile-buffer byte access"},
    "def_label":        {"searcher": "bfs",         "reason": "Codegen: define jump label"},
    "set_genstr_size":  {"searcher": "bfs",         "reason": "Tune codegen string buffer size"},

    "open_new_file":    {"searcher": "nurs:depth",  "reason": "Open and switch to new input file (recursive #include-like)"},
    "new_yy_file":      {"searcher": "nurs:depth",  "reason": "Lex helper to push a new file onto buffer stack"},
    "nextarg":          {"searcher": "bfs",         "reason": "Argv iteration"},
    "parse_args":       {"searcher": "nurs:covnew", "reason": "Command-line option parser (getopt-driven)"},
    "make_arg_str":     {"searcher": "bfs",         "reason": "Build argv-derived string"},
    "arg_str":          {"searcher": "bfs",         "reason": "Iterate one argv element"},
    "call_str":         {"searcher": "bfs",         "reason": "Build call-string for traceback"},
    "long_val":         {"searcher": "bfs",         "reason": "Parse long from string; small loop"},
    "strcopyof":        {"searcher": "bfs",         "reason": "strdup-like helper"},
    "show_bc_version":  {"searcher": "bfs",         "reason": "Print version banner; trivial"},
    "warranty":         {"searcher": "bfs",         "reason": "Print warranty text; trivial"},
    "welcome":          {"searcher": "bfs",         "reason": "Print welcome; trivial"},
    "usage":            {"searcher": "bfs",         "reason": "Print usage; trivial"},
    "rt_warn":          {"searcher": "bfs",         "reason": "Runtime warning printer"},
    "rt_error":         {"searcher": "bfs",         "reason": "Runtime error printer"},
    "ct_warn":          {"searcher": "bfs",         "reason": "Compile-time warning printer"},
    "out_of_memory":    {"searcher": "bfs",         "reason": "OOM handler; usually exits"},
    "bc_malloc":        {"searcher": "bfs",         "reason": "malloc wrapper with OOM check"},
    "bc_exit":          {"searcher": "bfs",         "reason": "Cleanup + exit"}
  }
}
